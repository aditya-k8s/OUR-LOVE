# Copy to .env and fill in. Never commit .env.

# --- Core ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Required behind HTTPS on a real domain, e.g. https://ourlove.example.com
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata

# --- MongoDB Atlas -----------------------------------------------------------
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=our_love

# --- Admin account (used by `python manage.py createadmin`) ------------------
ADMIN_USERNAME=
# Optional; if empty, createadmin prompts for it. Remove after first start.
ADMIN_PASSWORD=

# --- Privacy -----------------------------------------------------------------
# false: everyone must sign in. true: visitors see only items marked Public.
PUBLIC_SITE_ENABLED=false

# --- HTTPS / proxy -------------------------------------------------------------
# Defaults to True when DEBUG=False. Set False only for plain-HTTP local testing.
SECURE_HTTPS=True
# Set True behind a load balancer / reverse proxy that sets X-Forwarded-Proto.
BEHIND_PROXY=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- Media storage -----------------------------------------------------------
# local (disk, default) or s3 (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces)
MEDIA_STORAGE_PROVIDER=local
MEDIA_ROOT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=
# Only for non-AWS S3-compatible providers
AWS_S3_ENDPOINT_URL=
MEDIA_SIGNED_URL_SECONDS=3600

# --- Upload limits (MB) --------------------------------------------------------
MAX_IMAGE_UPLOAD_MB=20
MAX_VIDEO_UPLOAD_MB=300
MAX_IMPORT_UPLOAD_MB=25
# Largest request the host accepts; set automatically to 4.5 on Vercel. 0 = no limit.
REQUEST_LIMIT_MB=

# --- Optional ------------------------------------------------------------------
# Postgres for users/sessions instead of SQLite (required on Vercel, recommended on ECS/Fargate)
DATABASE_URL=
# Shared cache for rate limiting across several containers
REDIS_URL=
LOG_LEVEL=INFO
